PORT=8084

# Required in production (e.g. `openssl rand -hex 32`). In development a temporary one is generated.
JWT_SECRET=
JWT_EXPIRES_IN=86400

# Comma separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# SQLite is the default and needs no setup. For PostgreSQL:
# DB_DIALECT=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=apphub
# DB_USER=postgres
# DB_PASSWORD=
DB_STORAGE=./data/apphub.sqlite

# Load demo data when the database is empty
SEED_DEMO=true
