{
  "name": "apphub-api",
  "version": "1.0.0",
  "description": "REST API for an internal application portal: Express, Sequelize, JWT. Runs on SQLite out of the box, PostgreSQL in production.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node app/seed/run.js",
    "test": "node --test"
  },
  "keywords": ["nodejs", "express", "sequelize", "rest", "api", "jwt", "swagger"],
  "license": "MIT",
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
