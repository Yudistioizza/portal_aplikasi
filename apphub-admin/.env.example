APP_NAME="AppHub Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite works out of the box (php artisan migrate --seed).
# For PostgreSQL set DB_CONNECTION=pgsql and the DB_* values below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=apphub
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Mail: "log" writes messages to storage/logs instead of sending them
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Login SSO Microsoft (Azure AD) dinonaktifkan. Lihat app/Http/Controllers/Auth/AzureController.php
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI="${APP_URL}/login/azure/callback"
# AZURE_TENANT_ID=common

VITE_APP_NAME="${APP_NAME}"

# Show demo credentials on the login page (never enable in production)
DEMO_MODE=true
